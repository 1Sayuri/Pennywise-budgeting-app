<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/chEmoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_callout"
            android:text="💪"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="52-Week Challenge"
                android:textSize="15sp"
                android:textColor="@color/n_text"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/chSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Save $1 in week 1, $2 in week 2..."
                android:textSize="12sp"
                android:textColor="@color/n_gray"
                android:fontFamily="@font/inter" />

            <ProgressBar
                android:id="@+id/chProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_wish" />
        </LinearLayout>

        <!-- Start / Check in button -->
        <TextView
            android:id="@+id/chAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="@color/tag_green_bg"
            android:text="Start"
            android:textSize="13sp"
            android:textColor="@color/tag_green"
            android:fontFamily="@font/inter_semibold" />

        <!-- Trash button (separate view) -->
        <TextView
            android:id="@+id/chDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_callout"
            android:text="🗑️"
            android:textSize="15sp"
            android:contentDescription="Delete challenge" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/n_border" />
</LinearLayout>