<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/n_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- COVER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:background="@drawable/bg_cover" />

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-30dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <!-- PAGE ICON -->
                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_page_icon"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_piggy"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <!-- TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Budget"
                        android:textSize="30sp"
                        android:textColor="@color/n_text"
                        android:fontFamily="@font/inter_semibold" />

                    <!-- PROPERTIES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="118dp"
                            android:layout_height="wrap_content"
                            android:text="Balance"
                            android:textSize="14sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/balanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$914.50"
                            android:textSize="15sp"
                            android:textColor="@color/n_text"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="118dp"
                            android:layout_height="wrap_content"
                            android:text="This month"
                            android:textSize="14sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/incomeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:backgroundTint="@color/tag_green_bg"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="+$1,000"
                            android:textSize="14sp"
                            android:textColor="@color/tag_green"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:id="@+id/expenseText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag"
                            android:backgroundTint="@color/tag_red_bg"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="−$85.50"
                            android:textSize="14sp"
                            android:textColor="@color/tag_red"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- CALLOUT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_callout"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:src="@drawable/ic_bulb"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/calloutText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Headphones are 33% funded. $100 to go, nice pace."
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.2"
                            android:textColor="@color/n_text"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <!-- BUCKETS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Buckets"
                        android:textSize="16sp"
                        android:textColor="@color/n_text"
                        android:fontFamily="@font/inter_semibold" />

                    <!-- Table header -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/n_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Name"
                            android:textSize="12sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Left"
                            android:textSize="12sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Used"
                            android:textSize="12sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/n_border" />

                    <!-- Bucket rows get added here from Java -->
                    <LinearLayout
                        android:id="@+id/bucketList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- WISHLIST -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wishlist"
                            android:textSize="16sp"
                            android:textColor="@color/n_text"
                            android:fontFamily="@font/inter_semibold" />

                        <TextView
                            android:id="@+id/addWishLink"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:text="+ Add item"
                            android:textSize="13sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/n_border" />

                    <LinearLayout
                        android:id="@+id/wishList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/wishEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="Nothing yet. Add something you're saving for."
                        android:textSize="13sp"
                        android:textColor="@color/n_light_gray"
                        android:fontFamily="@font/inter" />
                    <!-- SAVINGS CHALLENGE -->
                    <LinearLayout
                        android:id="@+id/savingsChallengeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_callout"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Savings Challenges"
                            android:textSize="16sp"
                            android:textColor="@color/n_text"
                            android:fontFamily="@font/inter_semibold" />

                        <LinearLayout
                            android:id="@+id/dashChallengeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/dashChallengeEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="No active challenges. Pick one to start!"
                            android:textSize="13sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />

                        <Button
                            android:id="@+id/savingsChallengeButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:text="View Savings Challenges"
                            android:textAllCaps="false" />

                    </LinearLayout>
                    <!-- CARDS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cards"
                            android:textSize="16sp"
                            android:textColor="@color/n_text"
                            android:fontFamily="@font/inter_semibold" />

                        <TextView
                            android:id="@+id/addCardLink"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:text="+ Add card"
                            android:textSize="13sp"
                            android:textColor="@color/n_gray"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-20dp"
                        android:layout_marginEnd="-20dp"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/cardRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="14dp" />
                    </HorizontalScrollView>

                    <!-- Next sections go here -->

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom bar (later) -->
        <LinearLayout

            android:id="@+id/bottomBar"

            android:layout_width="match_parent"

            android:layout_height="72dp"

            android:orientation="horizontal"

            android:gravity="center"

            android:paddingStart="20dp"

            android:paddingEnd="20dp">

            <Button

                android:id="@+id/addTransactionButton"

                android:layout_width="match_parent"

                android:layout_height="48dp"

                android:text="+ Add transaction"

                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>