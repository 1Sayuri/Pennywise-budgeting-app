<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="258dp"
    android:layout_height="158dp"
    android:background="@drawable/card_art_sage"
    android:elevation="6dp">

    <!-- Soft glow circle -->
    <View
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|end"
        android:translationX="40dp"
        android:translationY="-60dp"
        android:background="@drawable/bg_card_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Top row: bank + type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cardBank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PennyBank"
                android:textSize="14sp"
                android:textColor="#1F2A1E"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/cardType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:backgroundTint="#4DFFFFFF"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="DEBIT"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:textColor="#1F2A1E"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <!-- Chip + contactless -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_card_chip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/cardWave"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_contactless"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Nickname + last four -->
        <TextView
            android:id="@+id/cardNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Everyday Card · •••• 4417"
            android:textSize="12sp"
            android:textColor="#33452F"
            android:fontFamily="@font/inter" />

        <!-- Balance row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/cardBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="$970.00"
                android:textSize="22sp"
                android:textColor="#1F2A1E"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/cardExtra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="$50 reserved"
                android:textSize="11sp"
                android:textColor="#33452F"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>