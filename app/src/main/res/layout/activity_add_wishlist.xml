<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="@color/n_bg"

    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textSize="16sp"
        android:textColor="@color/n_text"
        android:fontFamily="@font/inter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Add Wishlist Item"
        android:textSize="28sp"
        android:textColor="@color/n_text"
        android:fontFamily="@font/inter_semibold" />

    <ImageView
        android:id="@+id/wishlistImagePreview"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_callout"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="Wishlist item photo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Item Name"
        android:textSize="14sp"
        android:textColor="@color/n_text" />

    <EditText
        android:id="@+id/itemNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g. MacBook Air"
        android:inputType="textCapSentences"
        android:padding="12dp"
        android:background="@drawable/bg_callout" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Target Price ($)"
        android:textSize="14sp"
        android:textColor="@color/n_text" />

    <EditText
        android:id="@+id/priceInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="@drawable/bg_callout" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Emoji"
        android:textSize="14sp"
        android:textColor="@color/n_text" />

    <Spinner
        android:id="@+id/emojiSpinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Bank Account"
        android:textSize="14sp"
        android:textColor="@color/n_text" />

    <Spinner
        android:id="@+id/accountSpinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Product Link"
        android:textSize="14sp"
        android:textColor="@color/n_text" />

    <EditText
        android:id="@+id/linkInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="https://..."
        android:inputType="textUri"
        android:padding="12dp"
        android:background="@drawable/bg_callout" />

    <Button
        android:id="@+id/saveWishlistButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:text="Save Wishlist Item"
        android:textAllCaps="false" />

</LinearLayout>
</ScrollView>
